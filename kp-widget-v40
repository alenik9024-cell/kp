<body>

<button id="kpBtn" type="button">📄 Сформировать КП</button>
<div id="st">КП v39 · запуск…</div>

<script>
(function () {
  'use strict';

  var VERSION  = 'v39';
  var AUTO_URL = 'https://alenik9024-cell.github.io/kp/kp-auto.html?v=39';

  var st  = document.getElementById('st');
  var btn = document.getElementById('kpBtn');

  var w = window.EnvyCrmWidget;
  var dealId = '', clientId = '';
  var ready = false;

  function log(m, d) { try { console.log('[KP ' + VERSION + '] ' + m, d || ''); } catch (e) {} }
  function say(html) { st.innerHTML = html; }

  /* --- состояние библиотеки видно прямо в панели --- */
  var libState = window.EnvyCrmWidget
    ? '<span class="ok">загружена</span>'
    : (window.__KP_LIB_ERROR ? '<span class="err">НЕ загрузилась (сеть/блокировка)</span>'
                             : '<span class="warn">ожидание…</span>');
  say('<b>КП ' + VERSION + '</b><br>Библиотека EnvyCRM: ' + libState);
  log('старт', { lib: !!window.EnvyCrmWidget, err: !!window.__KP_LIB_ERROR });

  /* --- идентификаторы сделки: params + getDeal() как страховка --- */
  function getParam(p, names) {
    p = p || {};
    for (var i = 0; i < names.length; i++) {
      var v = p[names[i]];
      if (v !== undefined && v !== null && v !== '') return String(v);
    }
    return '';
  }

  function pullDeal() {
    return new Promise(function (resolve) {
      if (dealId) { resolve(); return; }
      try {
        if (!w || typeof w.getDeal !== 'function') { resolve(); return; }
        var r = w.getDeal();
        if (r && typeof r.then === 'function') {
          r.then(function (d) {
            if (d) {
              dealId   = String(d.id || d.deal_id || d.ID || dealId || '');
              clientId = String(d.client_id || d.clientId || clientId || '');
            }
            log('getDeal', d);
            resolve();
          }).catch(function (e) { log('getDeal ошибка', e); resolve(); });
        } else { resolve(); }
      } catch (e) { log('getDeal исключение', e); resolve(); }
    });
  }

  /* --- открытие конструктора --- */
  function openConstructor() {
    var url = AUTO_URL +
      '&deal_id='   + encodeURIComponent(dealId) +
      '&client_id=' + encodeURIComponent(clientId);

    var html = '<iframe src="' + url +
      '" style="width:100%;height:80vh;border:0;display:block"></iframe>';

    log('открываю конструктор', { deal_id: dealId, client_id: clientId });

    try {
      if (w && typeof w.openPage === 'function') {
        w.openPage({ content: html }).catch(function (e) {
          log('openPage не сработал', e);
          if (w && typeof w.openModal === 'function') {
            w.openModal({ title: 'Коммерческое предложение', content: html, width: 1250 });
          }
        });
        return;
      }
      if (w && typeof w.openModal === 'function') {
        w.openModal({ title: 'Коммерческое предложение', content: html, width: 1250 });
        return;
      }
      window.open(url, '_blank');
    } catch (e) {
      log('ошибка открытия', e);
      window.open(url, '_blank');
    }
  }

  /* --- кнопка ВНУТРИ панели расширения: исчезнуть не может --- */
  btn.addEventListener('click', function () {
    btn.disabled = true;
    pullDeal().then(function () {
      btn.disabled = false;
      openConstructor();
    });

  /* --- регистрация кнопки в шапке сделки: ровно как в рабочей v32 --- */
  function register() {
    w = window.EnvyCrmWidget;
    if (!w) { log('EnvyCrmWidget не найдена'); return; }

    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'kp-btn:click') {
        log('кнопка в шапке нажата');
        pullDeal().then(openConstructor);
      }
    }, false);

    try {
      w.init({
        'deal-btn': function (params) {
          dealId   = getParam(params, ['dealID', 'deal_id', 'dealId'])   || dealId;
          clientId = getParam(params, ['clientID', 'client_id', 'clientId']) || clientId;
          log('params', { deal_id: dealId, client_id: clientId });

          /* ОДНА кнопка. Несколько кнопок в слоте position гасят друг друга. */
          return [{
            title: 'Сформировать КП',
            styles: { color: '#fff', 'background-color': '#2F6BFF' },
            icon: 'md-description',
            clickEventName: 'kp-btn:click',
            position: ['first'],
            name: 'kp-btn-final-32'
          }];
        }
      });
      ready = true;
      log('кнопка зарегистрирована');
    } catch (e) { log('ошибка регистрации', e); }
  }

  function wait(n) {
    n = n || 0;
    if (window.EnvyCrmWidget) {
      register();
      pullDeal().then(function () {
        say('<b>КП ' + VERSION + '</b><br>Библиотека EnvyCRM: <span class="ok">загружена</span>' +
            '<br>Кнопка в шапке: ' + (ready ? '<span class="ok">зарегистрирована</span>'
                                            : '<span class="err">не зарегистрирована</span>') +
            '<br>Сделка: <b>' + (dealId || '—') + '</b> · Клиент: <b>' + (clientId || '—') + '</b>');
      });
      return;
    }
    if (n >= 60) {
      say('<b>КП ' + VERSION + '</b><br>Библиотека EnvyCRM: <span class="err">НЕ загрузилась</span>' +
          '<br>Проверьте адрес <code>cdn.saas-support.com</code> — он не открывается из этой сети.');
      log('библиотека не загрузилась за 6 с');
      return;
    }
    setTimeout(function () { wait(n + 1); }, 100);
  }

  wait(0);
})();
</script>
</body>
