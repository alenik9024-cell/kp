  .warn{color:#b8860b;font-weight:600}<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>КП — виджет</title>

<!-- ЕДИНСТВЕННЫЙ правильный адрес библиотеки виджета EnvyCRM.
     Без этого скрипта window.EnvyCrmWidget не существует,
     w.init() не вызывается — и кнопка в карточке не появляется. -->
<script src="https://cdn.saas-support.com/crm_assets/build/widget/js/envycrmwidget.min.js"
        onerror="window.__KP_LIB_ERROR=1"></script>

<style>
  body{margin:0;padding:12px;box-sizing:border-box;background:#fff;color:#2b2b2b;
       font:13px/1.45 -apple-system,Segoe UI,Roboto,Arial,sans-serif}
  #kpFallback{display:block;width:100%;padding:12px 14px;border:0;border-radius:10px;
       background:#2F6BFF;color:#fff;font:600 14px/1 inherit;cursor:pointer}
  #kpFallback:hover{background:#1f57e0}
  #kpState{margin-top:10px;font-size:12px;color:#666;line-height:1.55}
  #kpState b{color:#2b2b2b}
  .ok{color:#0a7d33;font-weight:600}
  .err{color:#c0392b;font-weight:600}
  .warn{color:#b8860b;font-weight:600}
</style>
</head>
<body>

<button id="kpFallback" type="button">📄 Сформировать КП</button>
<div id="kpState">КП v40 · запуск…</div>

<script>
(function () {
  'use strict';

  var VERSION  = 'v40';
  var AUTO_URL = 'https://alenik9024-cell.github.io/kp/kp-auto.html?v=40';

  var w = window.EnvyCrmWidget;
  var dealId = '', clientId = '';
  var registered = false;

  function log(m, d) { try { console.log('[KP ' + VERSION + '] ' + m, d || ''); } catch (e) {} }
  function state(html) { document.getElementById('kpState').innerHTML = html; }

  log('старт', { lib: !!w, libError: !!window.__KP_LIB_ERROR });

  function getParam(p, names) {
    p = p || {};
    for (var i = 0; i < names.length; i++) {
      var v = p[names[i]];
      if (v !== undefined && v !== null && v !== '') return String(v);
    }
    return '';
  }

  /* --- ID сделки: сначала getDeal(), затем params --- */
  function pullDeal() {
    return new Promise(function (resolve) {
      if (!w || typeof w.getDeal !== 'function') { resolve(); return; }
      try {
        var r = w.getDeal();
        if (r && typeof r.then === 'function') {
          r.then(function (d) {
            var o = d && d.result ? d.result : (d || {});
            dealId   = String(o.id || o.deal_id || dealId || '');
            clientId = String(o.client_id || o.clientId || clientId || '');
            log('getDeal', o);
            resolve();
          }).catch(function (e) { log('getDeal ошибка', e); resolve(); });
        } else { resolve(); }
      } catch (e) { log('getDeal исключение', e); resolve(); }
    });
  }

  function openConstructor() {
    var url = AUTO_URL +
      '&deal_id='   + encodeURIComponent(dealId) +
      '&client_id=' + encodeURIComponent(clientId);

    var html = '<iframe src="' + url +
      '" style="width:100%;height:80vh;border:0;display:block"></iframe>';

    log('открываю конструктор', { deal_id: dealId, client_id: clientId });

    try {
      if (w && typeof w.openPage === 'function') {
        w.openPage({ content: html }).catch(function (e) {
          log('openPage не сработал', e);
          if (w && typeof w.openModal === 'function') {
            w.openModal({ title: 'Коммерческое предложение', content: html, width: 1250 });
          }
        });
        return;
      }
      if (w && typeof w.openModal === 'function') {
        w.openModal({ title: 'Коммерческое предложение', content: html, width: 1250 });
        return;
      }
      window.open(url, '_blank');
    } catch (e) { log('ошибка открытия', e); window.open(url, '_blank'); }
  }

  /* --- кнопка внутри панели расширения: работает всегда --- */
  document.getElementById('kpFallback').addEventListener('click', function () {
    pullDeal().then(openConstructor);
  });

  /* --- кнопка в шапке карточки: ОДНА, как в рабочей v32 --- */
  function register() {
    w = window.EnvyCrmWidget;
    if (!w) { log('EnvyCrmWidget не найдена'); return; }

    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'kp-btn:click') {
        log('кнопка в шапке нажата');
        pullDeal().then(openConstructor);
      }
    }, false);

    try {
      var res = w.init({
        'deal-btn': function (params) {
          dealId   = getParam(params, ['dealID', 'deal_id', 'dealId'])       || dealId;
          clientId = getParam(params, ['clientID', 'client_id', 'clientId']) || clientId;
          log('params', { deal_id: dealId, client_id: clientId });

          /* РОВНО ОДНА кнопка: слот position один,
             несколько кнопок в нём гасят друг друга. */
          return [{
            title: 'Сформировать КП',
            styles: { color: '#fff', 'background-color': '#2F6BFF' },
            icon: 'md-description',
            clickEventName: 'kp-btn:click',
            position: ['first'],
            name: 'kp-btn-final-32'
          }];
        }
      });

      if (res && typeof res.then === 'function') {
        res.then(function (r) { log('init resolved', r); })
           .catch(function (e) { log('init rejected', e); });
      }
      registered = true;
      log('кнопка зарегистрирована');
    } catch (e) { log('ошибка регистрации', e); }
  }

  function wait(n) {
    n = n || 0;
    if (window.EnvyCrmWidget) {
      register();
      pullDeal().then(function () {
        state('<b>КП ' + VERSION + '</b><br>' +
              'Библиотека: <span class="ok">загружена</span><br>' +
              'Кнопка в шапке: ' + (registered ? '<span class="ok">зарегистрирована</span>'
                                               : '<span class="err">не зарегистрирована</span>') +
              '<br>Сделка: <b>' + (dealId || '—') + '</b>');
      });
      return;
    }
    if (n >= 60) {
      state('<b>КП ' + VERSION + '</b><br>' +
            'Библиотека: <span class="err">НЕ загружена</span><br>' +
            'Адрес <code>cdn.saas-support.com</code> недоступен из этой сети.');
      log('библиотека не загрузилась');
      return;
    }
    setTimeout(function () { wait(n + 1); }, 100);
  }

  wait(0);
})();
</script>
</body>
</html>
